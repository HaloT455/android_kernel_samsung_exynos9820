# Config file for beyond2lte
# This is merged with exynos9820_defconfig on build

# ALice V9R2: V9 with sucompat authorization fix and MGLRU enabled at boot
CONFIG_LOCALVERSION="-ALice-S10P-V9R2-MGLRU"
CONFIG_ALICE_EXYNOS9820_FREQ_ONLY_OC=y

# TZDEV
# CONFIG_TZDEV_DEPLOY_OLD_TZAR is not set

# Touchscreen
CONFIG_TOUCHSCREEN_SEC_TS_Y771=y

# Camera
CONFIG_CAMERA_CIS_3M3_OBJ=y
CONFIG_CAMERA_CIS_4HA_OBJ=y
CONFIG_CAMERA_BSS_V02=y

# Decon
CONFIG_EXYNOS_DSIM_DITHER=y

# Sound
CONFIG_SND_SOC_SAMSUNG_BEYOND_MADERA=y
CONFIG_SND_SOC_SAMSUNG_SYSFS_EARJACK=y
CONFIG_SND_SOC_SAMSUNG_ABOX_DRAM_SIZE=0x1C00000

# Extcon
CONFIG_EXTCON_MADERA=y
CONFIG_EXTCON_MADERA_INPUT_EVENT=y

# Charging/Battery
CONFIG_MAX77705_GRL_ENABLE=y

# Vibrator
CONFIG_MAX77705_VIBRATOR=y
CONFIG_SEC_VIBRATOR=y
CONFIG_SEC_VIB_NOTIFIER=y

# Sensors
CONFIG_SENSORS_SSP_BEYOND=y
CONFIG_SENSORS_MAX86915=y

# The user validated the core MGLRU path at runtime on V9.
# Start it at boot; retain the same ARM64 access-flag capabilities as V9.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# CONFIG_LRU_GEN_STATS is not set
